# ============================================================================
# Real-Time Multiplayer Drawing & Guessing Game - Environment Configuration
# ============================================================================

# --- Backend Configuration ---
APP_NAME="SketchSync - Multiplayer Drawing & Guessing Game"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- Database Configuration (MySQL 8.0) ---
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
MYSQL_USER=gameuser
MYSQL_PASSWORD=gamepassword
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=drawing_game_db

DATABASE_URL=mysql+pymysql://gameuser:gamepassword@localhost:3306/drawing_game_db

# Fallback to SQLite if MySQL is not running locally during quick dev/testing
# Set USE_SQLITE_FALLBACK=true for zero-config local execution without Docker
USE_SQLITE_FALLBACK=false

# --- Game Engine Configuration ---
MIN_PLAYERS=2
MAX_PLAYERS=10
DEFAULT_TOTAL_ROUNDS=3
DEFAULT_ROUND_DURATION_SECONDS=60
ROUND_INTERMISSION_SECONDS=5

# --- CORS & Frontend Configuration ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
