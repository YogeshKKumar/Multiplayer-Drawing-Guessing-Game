APP_NAME="SketchSync - Multiplayer Drawing & Guessing Game"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# MySQL 8.0 Connection URL
DATABASE_URL=mysql+pymysql://gameuser:gamepassword@localhost:3306/drawing_game_db

# Set to true to automatically fallback to local SQLite if MySQL 8.0 is unreachable
USE_SQLITE_FALLBACK=true

# Game Settings
MIN_PLAYERS=2
MAX_PLAYERS=10
DEFAULT_TOTAL_ROUNDS=3
DEFAULT_ROUND_DURATION_SECONDS=60
ROUND_INTERMISSION_SECONDS=5

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
